# Gemini（Vertex AI）の接続設定。実際の値はサーバー側の環境変数で設定し、コミットしない。
# 認証はApplication Default Credentials（ローカルは `gcloud auth application-default login`、
# Firebase App Hostingではサービスアカウント）で行う。APIキーやトークンはここに書かない。

# 利用するGoogle CloudプロジェクトのID（必須）
GOOGLE_CLOUD_PROJECT=
# Vertex AIのロケーション（省略時: global）
GOOGLE_CLOUD_LOCATION=global
# 利用するGeminiのモデル（省略時: gemini-3.5-flash）
GEMINI_MODEL=gemini-3.5-flash

# 旅程生成API（POST /api/trips/generate）を受け付けるか。認証・利用制限が入るまでは、
# 既定で無効。課金を伴うため、意図した環境でだけ true にする。
TRIP_GENERATION_ENABLED=false
