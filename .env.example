# Gemini（Vertex AI）の接続設定。実際の値はサーバー側の環境変数で設定し、コミットしない。
# 認証はApplication Default Credentials（ローカルは `gcloud auth application-default login`、
# Firebase App Hostingではサービスアカウント）で行う。APIキーやトークンはここに書かない。

# 利用するGoogle CloudプロジェクトのID（必須）
GOOGLE_CLOUD_PROJECT=
# Vertex AIのロケーション（省略時: global）
GOOGLE_CLOUD_LOCATION=global
# 利用するGeminiのモデル（省略時: gemini-3.5-flash）
GEMINI_MODEL=gemini-3.5-flash

# 旅程生成API（POST /api/trips/generate）を受け付けるか。既定は無効。
# 本番の招待制デモには共通ゲートも必要。docs/API_ABUSE_PROTECTION.md を参照。
TRIP_GENERATION_ENABLED=false

# 学びの候補の作成API（POST /api/learnings/candidates）を受け付けるか。既定は無効。
# 本番の招待制デモには共通ゲートも必要。docs/API_ABUSE_PROTECTION.md を参照。
LEARNING_CANDIDATES_ENABLED=false

# Firestore保存API。既定は無効。公開条件は docs/API_ABUSE_PROTECTION.md を参照。
PERSISTENCE_ENABLED=false

# Firebase Consoleの現行Webアプリ設定。サーバーのproject IDと必ず一致させる。
# APIキーはFirebase Web SDK用。有料APIキー・秘密鍵をここへ設定しない。
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-groundtrip
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-groundtrip.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

# ローカルのnext dev専用。本番では両方falseにし、実プロジェクトの値に置き換える。
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true
FIREBASE_USE_EMULATORS=true
FIREBASE_PROJECT_ID=demo-groundtrip
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# 本番はEmulator HOSTの2変数自体を削除する。GOOGLE_APPLICATION_CREDENTIALSは設定しない。

# 旅程の照合API（POST /api/trips/verify。Places/Routesを呼ぶ）を受け付けるか。既定は無効。
# 本番の招待制デモには共通ゲートも必要。docs/API_ABUSE_PROTECTION.md を参照。
TRIP_VERIFICATION_ENABLED=false

# 部分修正API（POST /api/trips/revise。GeminiとPlaces・Routesを呼ぶ）を受け付けるか。既定は無効。
# 本番の招待制デモには共通ゲートも必要。docs/API_ABUSE_PROTECTION.md を参照。
TRIP_REVISION_ENABLED=false

# 招待制の実APIデモ。本番の共通ゲートも既定は無効。審査・実環境検証前は false を維持。
COSTLY_API_DEMO_ENABLED=false
# サーバー専用のFirebase UID配列。実UIDはSecret Managerで扱い、コミットしない。
COSTLY_API_INVITED_UIDS=[]
# Web App Check用の公開サイトキー。reCAPTCHA Enterpriseの秘密鍵を入れない。
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
