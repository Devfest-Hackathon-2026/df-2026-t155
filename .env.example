# Gemini（Vertex AI）の接続設定。実際の値はサーバー側の環境変数で設定し、コミットしない。
# 認証はApplication Default Credentials（ローカルは `gcloud auth application-default login`、
# Firebase App Hostingではサービスアカウント）で行う。APIキーやトークンはここに書かない。

# 利用するGoogle CloudプロジェクトのID（必須）
GOOGLE_CLOUD_PROJECT=
# Vertex AIのロケーション（省略時: global）
GOOGLE_CLOUD_LOCATION=global
# 利用するGeminiのモデル（省略時: gemini-3.5-flash）
GEMINI_MODEL=gemini-3.5-flash

# 旅程生成API（POST /api/trips/generate）を受け付けるか。認証・利用制限が入るまでは、
# 既定で無効。課金を伴うため、意図した環境でだけ true にする。
TRIP_GENERATION_ENABLED=false

# 学びの候補の作成API（POST /api/learnings/candidates）を受け付けるか。認証・利用制限が入るまでは、
# 既定で無効。課金を伴うため、意図した環境でだけ true にする。
LEARNING_CANDIDATES_ENABLED=false

# Firebase Consoleの現行Webアプリ設定。サーバーのproject IDと必ず一致させる。
# APIキーはFirebase Web SDK用。有料APIキー・秘密鍵をここへ設定しない。
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-groundtrip
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-groundtrip.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

# ローカルのnext dev専用。本番では両方falseにし、実プロジェクトの値に置き換える。
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true
FIREBASE_USE_EMULATORS=true
FIREBASE_PROJECT_ID=demo-groundtrip
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# 本番はEmulator HOSTの2変数自体を削除する。GOOGLE_APPLICATION_CREDENTIALSは設定しない。
